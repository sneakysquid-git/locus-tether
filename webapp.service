[Unit]
Description=Omi on-demand web dashboard
After=network.target

[Service]
Type=simple
User=efranklin
WorkingDirectory=/home/efranklin/projects/thor-training
Environment=OMI_PIPELINE_BASE=/home/efranklin/omi-data
ExecStart=/usr/bin/python3 /home/efranklin/projects/thor-training/webapp.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
