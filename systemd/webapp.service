[Unit]
Description=Omi on-demand web dashboard
After=network.target

[Service]
Type=simple
# EDIT ALL THREE LINES BELOW to match your actual username/home directory.
# Systemd's %h specifier looks like the obvious fix here, but does NOT work
# for this: in system-level units (these), %h resolves to the SERVICE
# MANAGER's home (root, i.e. /root) — not the User= account's home — despite
# what the name suggests. That's documented systemd behavior, not a bug in
# this file; %h only reliably reflects User= inside `systemctl --user`
# instances, not system-wide ones like this.
User=efranklin
WorkingDirectory=/home/efranklin/projects/thor-training/webapp
Environment=OMI_PIPELINE_BASE=/home/efranklin/omi-data
ExecStart=/usr/bin/python3 /home/efranklin/projects/thor-training/webapp/webapp.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
