[Unit]
Description=LocusTether audio watcher/transcriber (bare-metal, no Docker)
After=network.target

[Service]
Type=simple
# EDIT ALL PATHS BELOW — see webapp.service for why %h doesn't work here
# (it resolves to root's home in system-level units, not User='s home).
User=<your-username>
WorkingDirectory=/home/<your-username>/projects/thor-training/pipeline
Environment=OMI_PIPELINE_BASE=/home/<your-username>/omi-data
ExecStart=/home/<your-username>/projects/thor-training/.venv/bin/python /home/<your-username>/projects/thor-training/pipeline/watcher.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
