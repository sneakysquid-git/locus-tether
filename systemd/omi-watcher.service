[Unit]
Description=Omi audio watcher/transcriber (bare-metal, no Docker)
After=network.target

[Service]
Type=simple
# EDIT ALL PATHS BELOW — see webapp.service for why %h doesn't work here
# (it resolves to root's home in system-level units, not User='s home).
User=efranklin
WorkingDirectory=/home/efranklin/projects/thor-training/pipeline
Environment=OMI_PIPELINE_BASE=/home/efranklin/omi-data
ExecStart=/home/efranklin/projects/thor-training/.venv/bin/python /home/efranklin/projects/thor-training/pipeline/watcher.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
