[Unit]
Description=Omi audio watcher/transcriber (bare-metal, no Docker)
After=network.target

[Service]
Type=simple
# EDIT THIS to your actual username — systemd requires a concrete user here,
# %h (used below) only expands to THAT user's home directory once set.
User=efranklin
WorkingDirectory=%h/projects/thor-training/pipeline
# Note: this points at the DATA directory (~/omi-data), not the code repo —
# same separation described in README's "Directory layout on the Thor".
Environment=OMI_PIPELINE_BASE=%h/omi-data
ExecStart=%h/projects/thor-training/.venv/bin/python %h/projects/thor-training/pipeline/watcher.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
