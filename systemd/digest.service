[Unit]
Description=Generate today's LocusTether conversation digest
After=network.target

[Service]
Type=oneshot
# EDIT ALL THREE LINES BELOW — see webapp.service for why %h doesn't work
# here (it resolves to root's home in system-level units, not User='s home).
User=<your-username>
WorkingDirectory=/home/<your-username>/projects/thor-training/digest
Environment=OMI_PIPELINE_BASE=/home/<your-username>/omi-data
ExecStart=/usr/bin/python3 /home/<your-username>/projects/thor-training/digest/digest.py
