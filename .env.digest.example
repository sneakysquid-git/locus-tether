# Copy this file to .env.digest (same directory) and fill in real values.
# .env.digest is git-ignored — it will NEVER be committed, unlike this
# .example file. Do not put real credentials in this file.
#
# If you'd rather not set up email at all, just leave DIGEST_EMAIL_ENABLED
# as false (or don't create .env.digest at all) — digest.py still writes the
# markdown file to DIGESTS_DIR either way; this only controls whether it
# ALSO emails it to you.

OMI_DIGEST_EMAIL_ENABLED=false

# Most providers use port 587 with STARTTLS, or port 465 with implicit TLS
# (SSL from the start). digest.py picks the right connection method based
# on this port number automatically.
OMI_DIGEST_SMTP_HOST=smtp.gmail.com
OMI_DIGEST_SMTP_PORT=587

# For Gmail specifically: your regular password will NOT work here if you
# have 2FA enabled (which you should). Generate an "App Password" instead:
# https://myaccount.google.com/apppasswords
OMI_DIGEST_SMTP_USER=you@gmail.com
OMI_DIGEST_SMTP_PASSWORD=your-app-password-here

OMI_DIGEST_EMAIL_FROM=you@gmail.com
OMI_DIGEST_EMAIL_TO=you@gmail.com
