# Copy this to `.env` (same directory you run `docker compose` from — repo
# root, if you're following the README) and adjust the path if you want data
# somewhere other than the suggested ~/omi-data.
#
# This is intentionally OUTSIDE the ~/projects/thor-training code checkout —
# see the README's "Directory layout on the Thor" section for why.
#
# Note: this is NOT the same as OMI_PIPELINE_BASE set inside the container in
# docker-compose.yml (that one's fixed at /app, the in-container path). This
# is the corresponding path on the HOST filesystem.
OMI_DATA_DIR=/home/<your-username>/omi-data

# --- Phase 1 diarization (speaker labels) ---
# Needs a free Hugging Face account, plus accepting THREE model agreements
# (all required, instant approval):
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
# Then generate a token (Read access is enough):
#   https://huggingface.co/settings/tokens
HF_TOKEN=hf_your-token-here

# Set to false to skip diarization entirely — e.g. on a smaller GPU where
# the added ~4GB isn't available. Transcription and analysis both work
# completely fine without it either way. See HARDWARE.md.
OMI_DIARIZATION_ENABLED=true
