# Copy this to `.env` (same directory you run `docker compose` from — repo
# root, if you're following the README) and adjust the path if you want data
# somewhere other than the suggested ~/omi-data.
#
# This is intentionally OUTSIDE the ~/projects/omi-pipeline code checkout —
# see the README's "Directory layout on the Thor" section for why.
#
# Note: this is NOT the same as OMI_PIPELINE_BASE set inside the container in
# docker-compose.yml (that one's fixed at /app, the in-container path). This
# is the corresponding path on the HOST filesystem.
OMI_DATA_DIR=/home/efranklin/omi-data
