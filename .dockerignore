# Runtime data should live OUTSIDE this repo entirely (see README), but this
# is a defensive backstop in case anything ever ends up here anyway — none of
# it should be sent to the Docker build context.
inbox/
processing/
archive/
transcripts/
failed/
*.log

# Local Python/dev junk
__pycache__/
*.pyc
.venv/
venv/

# Git metadata doesn't need to be in the build context either
.git/
.gitignore
