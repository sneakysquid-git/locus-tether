[Unit]
Description=Generate today's Omi conversation digest
After=network.target

[Service]
Type=oneshot
User=efranklin
WorkingDirectory=/home/efranklin/projects/thor-training
Environment=OMI_PIPELINE_BASE=/home/efranklin/omi-data
ExecStart=/usr/bin/python3 /home/efranklin/projects/thor-training/digest.py
